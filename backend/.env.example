# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & JWT
JWT_SECRET=pinpilot-super-secret-jwt-key-change-in-production-2025
JWT_EXPIRES_IN=30d
ENCRYPTION_SECRET=pinpilot-aes-256-gcm-secret-key-32-characters-min!

# Database (MongoDB Atlas or Local MongoDB)
# Leave empty or set to your MongoDB Atlas connection string
MONGODB_URI=

# Official Pinterest API v5 OAuth App Credentials
# Create your Pinterest App in https://developers.pinterest.com/apps/
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5000/api/pinterest/callback

# Cloudinary (Permanent Storage for 1000x1500 Pinterest Images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Content & Image Generation APIs (Optional overrides)
# PinPilot includes built-in high quality generation if API keys are not provided
GEMINI_API_KEY=
OPENAI_API_KEY=
